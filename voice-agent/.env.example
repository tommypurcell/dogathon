# --- MODE: "local" (all on-device) or "hybrid" (cloud STT+TTS, local LLM) ---
# hybrid is much faster/more accurate but sends audio to LiveKit Cloud and needs
# real Cloud credentials below (run `lk cloud auth`, then `lk app env`).
MODE=hybrid

# --- LiveKit server (LiveKit Cloud project for hybrid mode) ---
LIVEKIT_URL=your-value-here
LIVEKIT_API_KEY=your-value-here
LIVEKIT_API_SECRET=your-value-here

# --- Cloud STT/TTS (only used when MODE=hybrid; via LiveKit Inference) ---
STT_MODEL=deepgram/nova-3
TTS_MODEL=cartesia/sonic-3        # built for ultra-low-latency real-time voice
TTS_VOICE=Blake

# --- LLM backend: "local" (Ollama, private) or "cloud" (LiveKit Inference, fast+smart) ---
LLM_BACKEND=cloud
CLOUD_LLM_MODEL=google/gemma-4-31b-it   # LiveKit's latency-optimized default for voice

# --- Local LLM via Ollama (used when LLM_BACKEND=local) ---
# Options you have: qwen2.5:3b (fast), qwen2.5:7b (smarter tools), llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b

# --- Local STT (faster-whisper) ---
# Model sizes: tiny, base, small, medium, large-v3  (bigger = more accurate, slower)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu          # "cpu" is safest on Mac; "auto" to let it try
WHISPER_COMPUTE_TYPE=int8   # int8 = fast + low memory on CPU

# --- Local TTS (Kokoro) ---
# Voice options include af_heart, af_bella, am_michael, bf_emma, etc.
KOKORO_VOICE=af_heart
